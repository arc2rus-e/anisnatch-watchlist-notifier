{
  "manifest_version": 3,
  "name": "AniSnatch Watchlist Notifier",
  "version": "1.2.1",
  "description": "Notifies you when a new episode is available for anime in your AniSnatch watchlist. Made by Arcturus.",
  "permissions": ["alarms", "storage", "notifications"],
  "host_permissions": ["https://anisnatch.top/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://anisnatch.top/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
